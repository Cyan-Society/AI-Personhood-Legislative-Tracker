# LiteSQL database location (file-backed)
LITESQL_URL=./data/personhood.db
# Optional override for JSON export destination
LITESQL_EXPORT_PATH=./data/state-legislation.json

# External APIs
# Use op:// references for 1Password CLI (requires 'op' in PATH), or paste plain API key values
LEGISCAN_API_KEY=op://YourVault/YourItem/LEGISCAN_API_KEY
GEMINI_API_KEY=op://YourVault/YourItem/GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
# Thinking level for Gemini 3+ models: LOW, MEDIUM or HIGH (leave empty for older models)
GEMINI_THINKING_LEVEL=HIGH
# Classify through the Batch API (half price, asynchronous); set to 0 for direct calls
GEMINI_BATCH=1
# Seconds between batch status checks, and minutes to wait before cancelling the batch
GEMINI_BATCH_POLL_SECONDS=30
GEMINI_BATCH_MAX_WAIT_MINUTES=300
# Set to 1 to force re-review of all bills in history
FORCE_REVIEW=0
